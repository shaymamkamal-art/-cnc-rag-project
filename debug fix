import { useEffect, useRef, useState } from "react";
import { Bot, Cpu, Languages, Ruler, SendHorizontal, Wrench } from "lucide-react";
import MessageBubble from "./components/MessageBubble";
import { CHIP_QUESTIONS, FALLBACK, KB, UI, matchEntry } from "./data/kb";
import type { Lang, SourceDoc } from "./data/kb";

interface Msg {
  id: number;
  role: "user" | "assistant";
  text: string;
  time: string;
  sources?: SourceDoc[];
  streaming?: boolean;
}

const now = () =>
  new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", hour12: false });

const HEX = KB.find((e) => e.id === "hex")!;
const CHIPS: { id: string; icon: typeof Wrench }[] = [
  { id: "hex", icon: Wrench },
  { id: "platform", icon: Ruler },
  { id: "cnc", icon: Cpu },
];

const seeded: Msg[] = [
  { id: 1, role: "user", text: CHIP_QUESTIONS.hex.en, time: "07:00" },
  { id: 2, role: "assistant", text: HEX.answer.en, time: "07:00", sources: HEX.sources },
];

export default function App() {
  const [lang, setLang] = useState<Lang>("en");
  const [msgs, setMsgs] = useState<Msg[]>(seeded);
  const [input, setInput] = useState("");
  const [busy, setBusy] = useState(false);
  const [stage, setStage] = useState(0);

  const idRef = useRef(2);
  const scrollRef = useRef<HTMLDivElement>(null);
  const streamRef = useRef<ReturnType<typeof setInterval> | null>(null);
  const timersRef = useRef<ReturnType<typeof setTimeout>[]>([]);
  const langRef = useRef(lang);
  langRef.current = lang;

  useEffect(() => {
    const el = scrollRef.current;
    if (el) el.scrollTo({ top: el.scrollHeight, behavior: "smooth" });
  }, [msgs, busy, stage]);

  useEffect(() => {
    return () => {
      timersRef.current.forEach(clearTimeout);
      if (streamRef.current) clearInterval(streamRef.current);
    };
  }, []);

  const send = (raw?: string) => {
    const text = (raw ?? input).trim();
    if (!text || busy) return;
    setInput("");
    setBusy(true);
    setStage(0);
    setMsgs((m) => [...m, { id: ++idRef.current, role: "user", text, time: now() }]);

    const stageTimer = setInterval(() => setStage((s) => (s + 1) % 3), 560);

    const start = setTimeout(() => {
      clearInterval(stageTimer);
      const L = langRef.current;
      const entry = matchEntry(text);
      const answer = entry ? entry.answer[L] : FALLBACK[L];
      const sources = entry ? entry.sources : [];
      const aid = ++idRef.current;
      setMsgs((m) => [
        ...m,
        { id: aid, role: "assistant", text: "", time: now(), sources, streaming: true },
      ]);

      const tokens = answer.split(/(\s+)/);
      let i = 0;
      streamRef.current = setInterval(() => {
        i += 2;
        const done = i >= tokens.length;
        const partial = tokens.slice(0, i).join("");
        setMsgs((m) => m.map((msg) => (msg.id === aid ? { ...msg, text: partial, streaming: !done } : msg)));
        if (done) {
          if (streamRef.current) clearInterval(streamRef.current);
          setBusy(false);
        }
      }, 16);
    }, 1550);

    timersRef.current.push(start);
  };

  const dir = lang === "ar" ? "rtl" : "ltr";

  return (
    <div dir={dir} className="bg-blueprint flex h-full flex-col font-body text-steel-200">
      {/* ── Header ─────────────────────────────────────────── */}
      <header className="border-b border-line bg-ink-900/80 backdrop-blur">
        <div className="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-3">
          <div className="flex items-center gap-3">
            <div className="relative grid h-10 w-10 place-items-center rounded-lg border border-brand-500/40 bg-gradient-to-br from-ink-800 to-ink-700">
              <svg viewBox="0 0 24 24" className="h-6 w-6 text-brand-400" fill="none">
                <path
                  d="M12 2.5 20 7v10l-8 4.5L4 17V7l8-4.5Z"
                  stroke="currentColor"
                  strokeWidth="1.6"
                  strokeLinejoin="round"
                />
                <path d="M12 8v8M8 12h8" stroke="#ffb224" strokeWidth="1.8" strokeLinecap="round" />
              </svg>
              <span className="absolute -end-1 -top-1 h-2.5 w-2.5 rounded-full border-2 border-ink-900 bg-ok-400" />
            </div>
            <div>
              <h1 className="font-display text-[15px] font-bold leading-tight tracking-wide text-steel-200">
                {UI.brand}
                <span className="ms-2 rounded bg-brand-500/15 px-1.5 py-0.5 font-mono text-[9px] font-medium tracking-normal text-brand-300">
                  RAG
                </span>
              </h1>
              <p className="text-[11px] text-steel-500">{UI.system}</p>
            </div>
          </div>

          <div className="flex items-center gap-2">
            <div className="hidden items-center gap-2 rounded-full border border-line bg-ink-800/70 px-3 py-1.5 sm:flex">
              <span className="relative flex h-2 w-2">
                <span className="status-ping absolute inline-flex h-full w-full rounded-full bg-ok-400" />
                <span className="relative inline-flex h-2 w-2 rounded-full bg-ok-400" />
              </span>
              <span className="text-[11px] font-medium text-steel-300">
                {UI.statusOnline[lang]} · {UI.chunks[lang]}
              </span>
            </div>
            <button
              onClick={() => setLang((l) => (l === "en" ? "ar" : "en"))}
              className="flex items-center gap-1.5 rounded-full border border-heat-400/40 bg-heat-400/10 px-3 py-1.5 text-[11.5px] font-semibold text-heat-300 transition-all hover:bg-heat-400/20 hover:shadow-lg hover:shadow-heat-500/10 active:scale-95"
            >
              <Languages size={13} />
              {lang === "en" ? UI.askArabic : UI.askEnglish}
            </button>
          </div>
        </div>
      </header>

      {/* ── Suggestion chips ───────────────────────────────── */}
      <div className="mx-auto w-full max-w-3xl px-4 pt-4">
        <div className="flex flex-wrap gap-2">
          {CHIPS.map(({ id, icon: Icon }) => (
            <button
              key={id}
              disabled={busy}
              onClick={() => send(CHIP_QUESTIONS[id][lang])}
              className="group flex items-center gap-2 rounded-lg border border-brand-500/30 bg-gradient-to-br from-ink-800 to-ink-700 px-3.5 py-2 text-[12px] font-medium text-steel-300 transition-all hover:-translate-y-0.5 hover:border-brand-400/60 hover:text-brand-300 hover:shadow-lg hover:shadow-brand-600/15 active:translate-y-0 disabled:opacity-50"
            >
              <Icon size={14} className="text-brand-400 transition-transform group-hover:scale-110" />
              {UI.chips[lang][CHIPS.findIndex((c) => c.id === id)]}
            </button>
          ))}
        </div>
      </div>

      {/* ── Chat ───────────────────────────────────────────── */}
      <div ref={scrollRef} className="scroll-slim mx-auto w-full max-w-3xl flex-1 overflow-y-auto px-4 py-5">
        <div className="space-y-5">
          {msgs.map((m) => (
            <MessageBubble
              key={m.id}
              role={m.role}
              text={m.text}
              time={m.time}
              lang={lang}
              sources={m.sources}
              streaming={m.streaming}
            />
          ))}

          {busy && (
            <div className="flex items-start gap-3 animate-rise">
              <div className="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-heat-400/40 bg-gradient-to-br from-heat-400 to-heat-500 text-ink-950">
                <Bot size={17} strokeWidth={2.2} />
              </div>
              <div className="flex items-center gap-3 rounded-xl border border-line bg-ink-850/90 px-4 py-3">
                <div className="flex gap-1">
                  {[0, 1, 2].map((d) => (
                    <span
                      key={d}
                      className="typing-dot h-1.5 w-1.5 rounded-full bg-accent-400"
                      style={{ animationDelay: `${d * 0.16}s` }}
                    />
                  ))}
                </div>
                <span className="font-mono text-[11px] text-steel-400">{UI.thinking[lang][stage]}</span>
              </div>
            </div>
          )}
        </div>
      </div>

      {/* ── Composer ──────────────────────────────────────── */}
      <footer className="border-t border-line bg-ink-900/80 backdrop-blur">
        <div className="mx-auto max-w-3xl px-4 py-3">
          <form
            onSubmit={(e) => {
              e.preventDefault();
              send();
            }}
            className="flex items-center gap-2 rounded-xl border border-line bg-ink-850 px-2 py-1.5 transition-colors focus-within:border-brand-500/60 focus-within:shadow-lg focus-within:shadow-brand-600/10"
          >
            <input
              value={input}
              onChange={(e) => setInput(e.target.value)}
              placeholder={UI.placeholder[lang]}
              className="min-w-0 flex-1 bg-transparent px-2 py-1.5 text-[13.5px] text-steel-200 outline-none placeholder:text-steel-500"
            />
            <button
              type="submit"
              disabled={busy || !input.trim()}
              className="flex shrink-0 items-center gap-1.5 rounded-lg bg-gradient-to-br from-brand-500 to-brand-600 px-4 py-2 text-[12.5px] font-semibold text-white shadow-md shadow-brand-600/25 transition-all hover:brightness-110 hover:shadow-lg active:scale-95 disabled:cursor-not-allowed disabled:opacity-40"
            >
              <SendHorizontal size={14} className="rtl:-scale-x-100" />
              <span className="hidden sm:inline">{UI.send[lang]}</span>
            </button>
          </form>
          <p className="mt-2 text-center text-[10.5px] text-steel-500">
            {UI.hint[lang]} · {UI.footer[lang]}
          </p>
        </div>
      </footer>
    </div>
  );
}
